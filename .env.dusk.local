APP_NAME="Grafite Scaffold"
APP_ENV=testing
APP_KEY=base64:tUx23rtiQsNZtV4aRH38ofndb8lX05LWZaSXUYe+F/4=
APP_DEBUG=true
APP_URL=http://scaffold.test

# Register the PWA service worker. Defaults to production only; set true to
# test offline and push locally (needs https or localhost).
PWA_SERVICE_WORKER=false

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=test
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Web Push (generate with: php artisan webpush:vapid)
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# AI chat (see config/ai.php and config/conversation.php)
AI_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CONVERSATION_ENABLED=true
CONVERSATION_AGENT_MODEL=claude-sonnet-5-5
CONVERSATION_FAST_MODEL=claude-haiku-5-5
CONVERSATION_AGENT_FALLBACK_MODEL=gpt-6.1-sol
CONVERSATION_FAST_FALLBACK_MODEL=gpt-6-luna
CONVERSATION_IDLE_MINUTES=45
CONVERSATION_CONTINUATION_SECONDS=120
EXA_API_KEY=

STRIPE_KEY=
STRIPE_SECRET=

PLAN_MONTHLY=
PLAN_YEARLY=

